          "role": "textbox",
          "name": "Destination city",
          "label": "Destination city",
          "text": "",
          "testId": null,
          "id": "city",
          "idGenerated": false,
          "nameAttr": "city",
          "placeholder": "",
          "href": "",
          "classes": [],
          "nearText": "Destination city",
          "column": "",
