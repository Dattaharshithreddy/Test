{
  "relay": 1,
  "kind": "flow",
  "name": "Customer can create and track a shipment",
  "baseUrl": "{{webUrl}}",
  "variables": [
    {
      "key": "webUrl",
      "value": "http://127.0.0.1:4020"
    },
    {
      "key": "user",
      "value": "qa@shiptrack.test"
    },
    {
      "key": "password",
      "value": "secret123"
    }
  ],
  "session": {
    "name": "shiptrack-qa",
    "steps": [
      {
        "type": "open",
        "url": "/"
      },
      {
        "type": "fill",
        "target": {
          "describe": "Email",
          "fp": {
            "tag": "input",
            "type": "email",
            "role": "textbox",
            "name": "Email",
            "label": "Email",
