          ],
          "nearText": "Service: Express",
          "column": "",
          "container": null,
          "css": "main > div > p:nth-of-type(3) > span",
          "box": {
            "x": 317,
            "y": 254,
            "w": 58,
            "h": 20
          },
          "vw": 1280,
          "vh": 800,
          "ok": [
            "testId",
            "text",
            "css"
          ]
        }
      },
      "value": "Booked"
    },
    {
      "type": "check",
      "value": "Vijayawada"
    },
    {
      "type": "api",
      "method": "DELETE",
      "url": "/api/orders/{{seedId}}",
      "headers": {
        "Authorization": "Bearer demo-token"
      },
      "expectStatus": 204
    }
  ]
}
