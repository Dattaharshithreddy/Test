            "nameAttr": "password",
            "placeholder": "",
            "href": "",
            "classes": [],
            "nearText": "Password",
            "column": "",
            "container": null,
            "css": "#password",
            "box": {
              "x": 260,
              "y": 269,
              "w": 760,
              "h": 33
            },
            "vw": 1280,
            "vh": 800,
            "ok": [
              "role",
              "label",
              "id",
              "nameAttr",
              "css"
            ]
          }
        },
        "value": "{{password}}"
      },
      {
        "type": "click",
        "target": {
          "describe": "Sign in",
          "role": "button",
          "fp": {
            "tag": "button",
            "type": "submit",
            "role": "button",
            "name": "Sign in",
            "label": "",
            "text": "Sign in",
