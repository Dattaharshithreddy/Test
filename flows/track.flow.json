          "testId": null,
          "id": "save-shipment",
          "idGenerated": false,
          "nameAttr": "",
          "placeholder": "",
          "href": "",
          "classes": [],
          "nearText": "Service",
          "column": "",
          "container": null,
          "css": "#save-shipment",
          "box": {
            "x": 260,
            "y": 320,
            "w": 131,
            "h": 35
          },
          "vw": 1280,
          "vh": 800,
          "ok": [
            "role",
            "id",
            "css"
          ]
        }
      },
      "waitFor": "POST /api/orders",
      "effect": {
        "url": "/track/:id",
        "requests": [
          "GET /api/orders/:id",
          "GET /track/:id",
          "POST /api/orders"
        ]
      }
    },
    {
      "type": "check",
      "target": {
        "testId": "order-status",
        "describe": "Order status",
        "fp": {
          "tag": "span",
          "type": "",
          "role": "",
