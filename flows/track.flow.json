            "idGenerated": false,
            "nameAttr": "email",
            "placeholder": "",
            "href": "",
            "classes": [],
            "nearText": "Email",
            "column": "",
            "container": null,
            "css": "#email",
            "box": {
              "x": 260,
              "y": 203,
              "w": 760,
              "h": 33
            },
            "vw": 1280,
            "vh": 800,
            "ok": [
              "role",
              "label",
              "id",
              "nameAttr",
              "css"
            ]
          }
        },
        "value": "{{user}}"
      },
      {
        "type": "fill",
