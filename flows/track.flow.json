          "css": "#city",
          "box": {
            "x": 260,
            "y": 203,
            "w": 760,
            "h": 33
          },
          "vw": 1280,
          "vh": 800,
          "ok": [
            "role",
            "label",
            "id",
            "nameAttr",
            "css"
          ]
        }
      },
      "value": "Vijayawada"
    },
    {
      "type": "select",
      "target": {
        "describe": "Service",
        "fp": {
          "tag": "select",
          "type": "",
          "role": "combobox",
          "name": "Service",
          "label": "Service",
          "text": "Standard Express",
          "testId": null,
          "id": "speed",
          "idGenerated": false,
          "nameAttr": "speed",
          "placeholder": "",
          "href": "",
          "classes": [],
          "nearText": "Service",
          "column": "",
          "container": null,
          "css": "#speed",
          "box": {
            "x": 260,
            "y": 269,
            "w": 760,
            "h": 35
          },
          "vw": 1280,
          "vh": 800,
          "ok": [
            "role",
            "label",
            "id",
            "nameAttr",
            "css"
          ]
        }
      },
      "value": "Express"
