            "nameAttr": "",
            "placeholder": "",
            "href": "",
            "classes": [],
            "nearText": "Password",
            "column": "",
            "container": null,
            "css": "#login-btn",
            "box": {
              "x": 260,
              "y": 318,
              "w": 78,
              "h": 35
            },
            "vw": 1280,
            "vh": 800,
            "ok": [
              "role",
              "id",
              "css"
            ]
          }
        },
        "waitFor": "POST /api/login",
        "effect": {
          "url": "/dashboard",
          "requests": [
            "GET /api/orders",
            "GET /dashboard",
            "POST /api/login"
          ]
        }
      },
      {
        "type": "check",
        "expect": "url",
        "value": "/dashboard"
      }
    ]
  },
  "steps": [
    {
      "type": "api",
      "method": "POST",
      "url": "/api/orders",
      "headers": {
        "Authorization": "Bearer demo-token"
      },
      "body": {
        "city": "Hyderabad",
        "speed": "Express"
      },
      "save": {
        "seedId": "json.id"
      }
    },
    {
      "type": "open",
      "url": "/dashboard"
    },
    {
      "type": "check",
      "value": "Hyderabad"
    },
    {
      "type": "click",
      "target": {
        "describe": "New shipment",
        "role": "button",
        "fp": {
          "tag": "button",
          "type": "",
          "role": "button",
          "name": "New shipment",
          "label": "",
          "text": "New shipment",
          "testId": null,
          "id": "",
          "idGenerated": true,
          "nameAttr": "",
          "placeholder": "",
          "href": "",
          "classes": [
            "fade"
          ],
          "nearText": "Order To Status #1001 Hyderabad Booked",
          "column": "",
          "container": null,
          "css": "main > div:nth-of-type(2) > button",
          "box": {
            "x": 260,
            "y": 272,
            "w": 127,
            "h": 35
          },
          "vw": 1280,
          "vh": 800,
          "ok": [
            "role",
            "css"
          ]
        }
      },
      "effect": {
        "url": "/new",
        "requests": [
          "GET /new"
        ]
      }
    },
    {
      "type": "fill",
      "target": {
        "describe": "Destination city",
        "fp": {
          "tag": "input",
